<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        RECORD_AUDIO is required, not optional: AudioCapture calls
        getUserMedia({ audio: true }), and the WebView refuses it unless the
        app holds this permission. Capacitor's WebChromeClient turns the
        WebView's request into the Android runtime prompt.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
        CAMERA is for PhotoCapture's <input type="file" capture="environment">.
        Worth knowing it cuts both ways: an app that does NOT declare CAMERA
        can fire the camera-capture intent with no permission at all, whereas
        declaring it makes the runtime grant mandatory before that intent will
        run. Declared deliberately here so the prompt is explicit.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
        Both are genuinely optional hardware: required="false" keeps the app
        installable on a device without a camera or mic rather than having the
        Play Store filter it out.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
